public class VersionDefectuosa {



    public static boolean esDefectuosa(int version) {

        int primeraMala = 6;
        return version >= primeraMala;
    }


   
    public static int primeraDefectuosa(int lo, int hi) {
    
        if (lo == hi) {
            return lo;
        }
        int mid = lo + (hi - lo) / 2;

        
        if (esDefectuosa(mid)) {
         
            return primeraDefectuosa(lo, mid);
        } else {

            return primeraDefectuosa(mid + 1, hi);
        }
    }

    public static void main(String[] args) {
        int n = 13;
        int resultado = primeraDefectuosa(1, n);


        System.out.println("Total de versiones: " + n);
        System.out.println("La primera version defectuosa encontrada es: " + resultado);
    }
}
//¿Por qué mid = lo + (hi - lo) // 2 y no (lo + hi) // 2?
//- Básicamente por el "overflow" (desbordamiento). En lenguajes como C++ o Java, 
 // los enteros tienen un límite (el int de 32 bits llega hasta 2.147.483.647).
//- Si lo y hi son números muy grandes, al sumarlos (lo + hi) se pasan de ese 
  //límite, la compu se confunde y el número se vuelve negativo. ¡Eso te rompe todo!
//- Al restar (hi - lo) primero, sacas la distancia entre los dos, que siempre es 
 // /un número chiquito y seguro. Luego le sumas lo y listo, llegas al centro sin 
  //arriesgarte a romper la memoria. Matemáticamente da exacto lo mismo.

