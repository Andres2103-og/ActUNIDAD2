public class MinimoMaximo {

    public static class ResultadoMinMax {
        int min;
        int max;

        public ResultadoMinMax(int min, int max) {
            this.min = min;
            this.max = max;
        }
    }


    public static ResultadoMinMax obtenerMinMax(int[] arr, int lo, int hi) {

        if (lo == hi) {
            return new ResultadoMinMax(arr[lo], arr[lo]);
        }


        if (hi == lo + 1) {
            if (arr[lo] < arr[hi]) {
                return new ResultadoMinMax(arr[lo], arr[hi]);
            } else {
                return new ResultadoMinMax(arr[hi], arr[lo]);
            }
        }


        int mid = lo + (hi - lo) / 2;

  
        ResultadoMinMax izq = obtenerMinMax(arr, lo, mid);
        ResultadoMinMax der = obtenerMinMax(arr, mid + 1, hi);

        int minGlobal = Math.min(izq.min, der.min);
        int maxGlobal = Math.max(izq.max, der.max);

        return new ResultadoMinMax(minGlobal, maxGlobal);
    }

    public static void main(String[] args) {
        int[] latencias = {7, 2, 9, 4, 1, 8};

        ResultadoMinMax res = obtenerMinMax(latencias, 0, latencias.length - 1);


        System.out.println("Latencia Mínima: " + res.min);
        System.out.println("Latencia Máxima: " + res.max);
    }
}

